rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function linkPath() { return /databases/$(database)/documents/auth_links/$(request.auth.uid); }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function directoryPath(id) { return /databases/$(database)/documents/user_directory/$(id); }
    function registrationPath(uid) { return /databases/$(database)/documents/registration_requests/$(uid); }
    function reviewPath(uid) { return /databases/$(database)/documents/registration_review_events/$(uid); }
    function registrationPhonePath(phone) { return /databases/$(database)/documents/registration_phone_claims/$(phone); }
    function adminActionPath(id) { return /databases/$(database)/documents/admin_actions/$(id); }
    function ownId() { return get(linkPath()).data.user_id; }
    function knownRole(role) {
      return role in ['developer_admin', 'leader', 'executive', 'committee', 'member'];
    }
    function admitted() {
      return signedIn()
        && exists(linkPath()) && get(linkPath()).data.active == true
        && ownId() is string && ownId().size() > 0 && !ownId().matches('.*[/].*')
        && exists(userPath(ownId()))
        && get(userPath(ownId())).data.active == true
        && get(userPath(ownId())).data.login_enabled == true
        && knownRole(get(userPath(ownId())).data.access_role);
    }
    function developerAdmin() { return admitted() && get(userPath(ownId())).data.access_role == 'developer_admin'; }
    function unlinkedOwn(uid) {
      return signedIn() && uid == request.auth.uid && !exists(linkPath());
    }
    function nullableString(value) { return value == null || value is string; }
    function validUser(u) {
      return u.keys().hasAll(['name','phone','email','blood_group','profession','address','photo_url',
          'access_role','active','login_enabled','preferred_language','created_at','created_by','updated_at','updated_by'])
        && u.keys().hasOnly(['name','phone','email','blood_group','profession','address','photo_url',
          'access_role','active','login_enabled','preferred_language','created_at','created_by','updated_at','updated_by','last_admin_action_id'])
        && u.name is string && u.phone is string && nullableString(u.email)
        && nullableString(u.blood_group) && nullableString(u.profession) && nullableString(u.address)
        && nullableString(u.get('last_admin_action_id', null)) && nullableString(u.preferred_language)
        && (u.photo_url == null || (u.photo_url is string && u.photo_url.size() <= 2048 && u.photo_url.matches('https://[^/]+.*')))
        && knownRole(u.access_role) && u.active is bool && u.login_enabled is bool
        && u.created_at is timestamp && u.updated_at is timestamp
        && nullableString(u.created_by) && nullableString(u.updated_by);
    }
    function projection(u) {
      return {'name': u.name, 'phone': u.phone, 'blood_group': u.blood_group,
        'profession': u.profession, 'photo_url': u.photo_url, 'active': u.active};
    }
    // Called independently by BOTH write rules. At most five distinct document
    // accesses per write: link, User before/after, directory before/after.
    function ownProfileChange(id, before, after) {
      return admitted() && id == ownId() && validUser(before) && validUser(after)
        && after.diff(before).affectedKeys().hasOnly(['name','email','blood_group','profession',
          'address','photo_url','preferred_language','updated_at','updated_by'])
        && after.diff(before).affectedKeys().hasAny(['name','email','blood_group','profession','address','photo_url','preferred_language'])
        && after.updated_at == request.time && after.updated_by == id
        && get(directoryPath(id)).data == projection(before)
        && getAfter(directoryPath(id)).data == projection(after);
    }
    // Spark-safe admission. Only an existing linked developer_admin can
    // review an authenticated applicant's OWN request. Never mint new admins.
    function approvedReview(uid) {
      return get(registrationPath(uid)).data.status == 'pending'
        && getAfter(registrationPath(uid)).data.status == 'approved'
        && getAfter(registrationPath(uid)).data.linked_user_id == uid
        && getAfter(registrationPath(uid)).data.approved_by == ownId()
        && getAfter(registrationPath(uid)).data.approved_at == request.time;
    }
    function validNewMember(uid, u) {
      let r = get(registrationPath(uid)).data;
      return validUser(u) && approvedReview(uid)
        && u.name == r.name && u.phone == r.phone && u.email == r.email
        && u.blood_group == r.blood_group && u.profession == r.profession
        && u.address == r.address && u.photo_url == null
        && u.access_role == 'member' && u.active == true && u.login_enabled == true
        && u.preferred_language == null && u.created_at == request.time
        && u.updated_at == request.time && u.created_by == ownId()
        && u.updated_by == ownId()
        && u.get('last_admin_action_id', null) == null;
    }
    function admissionDocuments(uid) {
      let r = get(registrationPath(uid)).data;
      return r.phone.matches('01[3-9][0-9]{8}')
        && getAfter(userPath(uid)).data.access_role == 'member'
        && getAfter(userPath(uid)).data.phone == r.phone
        && getAfter(directoryPath(uid)).data == projection(getAfter(userPath(uid)).data)
        && getAfter(linkPathForUid(uid)).data.user_id == uid
        && getAfter(linkPathForUid(uid)).data.active == true
        && getAfter(registrationPhonePath(r.phone)).data.user_id == uid
        && getAfter(reviewPath(uid)).data.action == 'approve';
    }
    function linkPathForUid(uid) { return /databases/$(database)/documents/auth_links/$(uid); }
    function reviewEvent(uid, event) {
      return event.keys().hasAll(['action','actor_user_id','reviewed_at','reason'])
        && event.keys().hasOnly(['action','actor_user_id','reviewed_at','reason'])
        && event.actor_user_id == ownId() && event.reviewed_at == request.time
        && event.reason is string && event.reason.size() >= 10 && event.reason.size() <= 500
        && event.action in ['approve','reject']
        && get(registrationPath(uid)).data.status == 'pending'
        && getAfter(registrationPath(uid)).data.status == (event.action == 'approve' ? 'approved' : 'rejected')
        && (event.action != 'approve' || admissionDocuments(uid));
    }
    function adminBeforeAfter(id, after) {
      let before = resource.data;
      let op = after.get('last_admin_action_id', null);
      return developerAdmin() && id != ownId()
        && before.access_role != 'developer_admin'
        && after.access_role in ['member','committee','executive','leader']
        && after.name == before.name && after.phone == before.phone
        && after.diff(before).affectedKeys().hasOnly(['access_role','active','login_enabled',
          'updated_at','updated_by','last_admin_action_id'])
        && after.diff(before).affectedKeys().hasAny(['access_role','active','login_enabled'])
        && after.updated_at == request.time && after.updated_by == ownId()
        && op is string && op.size() > 0 && op.size() <= 120
        && op != before.get('last_admin_action_id', null)
        && getAfter(adminActionPath(op)).data.user_id == id
        && getAfter(adminActionPath(op)).data.actor_user_id == ownId()
        && getAfter(adminActionPath(op)).data.occurred_at == request.time
        && getAfter(directoryPath(id)).data == projection(after);
    }
    function adminActionValid(actionId, a) {
      let id = a.user_id;
      let before = get(userPath(id)).data;
      let after = getAfter(userPath(id)).data;
      return developerAdmin() && validId(id) && id != ownId()
        && before.access_role != 'developer_admin'
        && a.keys().hasAll(['user_id','actor_user_id','occurred_at','reason','before','after'])
        && a.keys().hasOnly(['user_id','actor_user_id','occurred_at','reason','before','after'])
        && a.actor_user_id == ownId() && a.occurred_at == request.time
        && a.reason is string && a.reason.size() >= 10 && a.reason.size() <= 500
        && a.before == {'access_role':before.access_role,'active':before.active,'login_enabled':before.login_enabled}
        && a.after == {'access_role':after.access_role,'active':after.active,'login_enabled':after.login_enabled}
        && after.get('last_admin_action_id', null) == actionId
        && after.updated_at == request.time && after.updated_by == ownId()
        && after.diff(before).affectedKeys().hasAny(['access_role','active','login_enabled']);
    }
    match /registration_requests/{uid} {
      allow get: if unlinkedOwn(uid)
        || (admitted() && editorial() && resource.data.status == 'pending');
      allow list: if admitted() && editorial() && resource.data.status == 'pending';
      allow create: if unlinkedOwn(uid)
        && request.resource.data.keys().hasAll(['auth_uid','name','phone','email','blood_group','profession','address','union', 'village',
          'status','requested_at','approved_by','approved_at','rejected_by','rejected_at','linked_user_id'])
        && request.resource.data.keys().hasOnly(['auth_uid','name','phone','email','blood_group','profession','address','union', 'village',
          'status','requested_at','approved_by','approved_at','rejected_by','rejected_at','linked_user_id'])
        && request.resource.data.auth_uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.phone is string
        && nullableString(request.resource.data.email)
        && nullableString(request.resource.data.blood_group)
        && nullableString(request.resource.data.profession)
        && nullableString(request.resource.data.address)
        && request.resource.data.union is string && request.resource.data.union.size() > 0
        && request.resource.data.village is string && request.resource.data.village.size() > 0
        && request.resource.data.status == 'pending' && request.resource.data.requested_at == request.time
        && request.resource.data.approved_by == null && request.resource.data.approved_at == null
        && request.resource.data.rejected_by == null && request.resource.data.rejected_at == null
        && request.resource.data.linked_user_id == null;
      // Admin action and its immutable review event must be in one batch.
      allow update: if developerAdmin() && uid != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','approved_by','approved_at','rejected_by','rejected_at','linked_user_id'])
        && request.resource.data.status in ['approved','rejected']
        && getAfter(reviewPath(uid)).data.action == (request.resource.data.status == 'approved' ? 'approve' : 'reject')
        && getAfter(reviewPath(uid)).data.actor_user_id == ownId()
        && getAfter(reviewPath(uid)).data.reviewed_at == request.time
        && (
          (request.resource.data.status == 'approved'
            && request.resource.data.approved_by == ownId()
            && request.resource.data.approved_at == request.time
            && request.resource.data.linked_user_id == uid
            && request.resource.data.rejected_by == null
            && request.resource.data.rejected_at == null
            && admissionDocuments(uid))
          ||
          (request.resource.data.status == 'rejected'
            && request.resource.data.rejected_by == ownId()
            && request.resource.data.rejected_at == request.time
            && request.resource.data.approved_by == null
            && request.resource.data.approved_at == null
            && request.resource.data.linked_user_id == null)
        );
    }
    match /registration_review_events/{uid} {
      allow get: if developerAdmin();
      allow create: if developerAdmin() && reviewEvent(uid, request.resource.data);
    }
    match /registration_phone_claims/{phone} {
      allow get: if developerAdmin() && phone.matches('01[3-9][0-9]{8}');
      allow create: if developerAdmin()
        && phone.matches('01[3-9][0-9]{8}')
        && request.resource.data.keys().hasAll(['user_id','claimed_at','claimed_by'])
        && request.resource.data.keys().hasOnly(['user_id','claimed_at','claimed_by'])
        && request.resource.data.user_id is string
        && request.resource.data.claimed_at == request.time
        && request.resource.data.claimed_by == ownId()
        && approvedReview(request.resource.data.user_id)
        && get(registrationPath(request.resource.data.user_id)).data.phone == phone
        && getAfter(userPath(request.resource.data.user_id)).data.phone == phone;
    }
    match /auth_links/{uid} {
      allow create: if developerAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasAll(['user_id','active','created_at','created_by'])
        && request.resource.data.keys().hasOnly(['user_id','active','created_at','created_by'])
        && request.resource.data.user_id == uid
        && request.resource.data.active == true
        && request.resource.data.created_at == request.time
        && request.resource.data.created_by == ownId()
        && approvedReview(uid) && validNewMember(uid, getAfter(userPath(uid)).data);
      allow get: if signedIn() && uid == request.auth.uid;
    }
    match /users/{id} {
      allow get: if admitted() && (id == ownId() || developerAdmin());
      allow list: if developerAdmin();
      allow create: if developerAdmin() && id != request.auth.uid
        && validNewMember(id, request.resource.data)
        && admissionDocuments(id);
      allow update: if ownProfileChange(id, resource.data, request.resource.data)
        || adminBeforeAfter(id, request.resource.data);
    }
    match /user_directory/{id} {
      allow read: if admitted() && resource.data.active == true;
      allow create: if developerAdmin() && approvedReview(id)
        && validNewMember(id, getAfter(userPath(id)).data)
        && request.resource.data == projection(getAfter(userPath(id)).data);
      allow update: if
        (ownProfileChange(id, get(userPath(id)).data, getAfter(userPath(id)).data)
          && request.resource.data == projection(getAfter(userPath(id)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','blood_group','profession','photo_url']))
        || (developerAdmin() && id != ownId()
          && get(userPath(id)).data.access_role != 'developer_admin'
          && request.resource.data == projection(getAfter(userPath(id)).data)
          && adminBeforeAfterDirectory(id));
    }
    function adminBeforeAfterDirectory(id) {
      let after = getAfter(userPath(id)).data;
      let before = get(userPath(id)).data;
      let op = after.get('last_admin_action_id', null);
      return after.active != before.active
        && op is string && getAfter(adminActionPath(op)).data.user_id == id
        && getAfter(adminActionPath(op)).data.occurred_at == request.time
        && after.updated_by == ownId() && after.updated_at == request.time;
    }
    match /admin_actions/{operationId} {
      allow create: if adminActionValid(operationId, request.resource.data);
      allow get, list: if developerAdmin();
    }
    function roleIn(roles) { return get(userPath(ownId())).data.access_role in roles; }

    function editorial() { return roleIn(['developer_admin', 'leader']); }
    function history() { return roleIn(['developer_admin', 'leader', 'executive']); }
    function validId(id) { return id is string && id.size() > 0 && !id.matches('.*[/].*'); }
    function eventReadable(e) { return e.active == true || (e.active == false && editorial()); }
    function validDonor(d) {
      return (
          (d.keys().hasAll(['name','phone','blood_group','gender','photo_url','village','union','upazila',
              'district','profession','linked_user_id','active','last_donated_at','total_donations',
              'created_at','created_by','updated_at','updated_by'])
            && d.keys().hasOnly(['name','phone','blood_group','gender','photo_url','village','union','upazila',
              'district','profession','linked_user_id','active','last_donated_at','total_donations',
              'created_at','created_by','updated_at','updated_by']))
          ||
          (d.keys().hasAll(['name','phone','blood_group','gender','photo_url','village','union','upazila',
              'district','profession','linked_user_id','active','last_donated_at','total_donations',
              'created_at','created_by','updated_at','updated_by'])
            && d.keys().hasOnly(['name','phone','blood_group','gender','photo_url','village','union','upazila',
              'district','profession','linked_user_id','active','last_donated_at','total_donations',
              'created_at','created_by','updated_at','updated_by']))
        )
        && d.name is string && d.phone is string && d.blood_group is string
        && nullableString(d.gender) && nullableString(d.village) && nullableString(d.union)
        && d.upazila is string && d.district is string && nullableString(d.profession)
        && (d.photo_url == null || (d.photo_url is string && d.photo_url.size() <= 2048
          && d.photo_url.matches('https://[^/]+.*')))
        && nullableString(d.linked_user_id) && d.active is bool
        && (d.last_donated_at == null || d.last_donated_at is timestamp)
        && d.total_donations is int && d.total_donations >= 0
        && d.created_at is timestamp && d.created_by is string
        && d.updated_at is timestamp && d.updated_by is string;
    }
    function validDonorPayload(d) {
      return (
          (d.keys().hasAll(['name','phone','blood_group','gender','photo_url','village','union','upazila','district','profession'])
            && d.keys().hasOnly(['name','phone','blood_group','gender','photo_url','village','union','upazila','district','profession']))
          ||
          (d.keys().hasAll(['name','phone','blood_group','gender','photo_url','village','union','upazila','district','profession'])
            && d.keys().hasOnly(['name','phone','blood_group','gender','photo_url','village','union','upazila','district','profession']))
        )
        && d.name is string && d.name.size() > 0 && d.phone is string && d.phone.size() > 0
        && d.blood_group is string && d.blood_group.size() > 0
        && nullableString(d.gender) && nullableString(d.village) && nullableString(d.union)
        && d.upazila is string && d.upazila.size() > 0 && d.district is string && d.district.size() > 0
        && nullableString(d.profession)
        && (d.photo_url == null || (d.photo_url is string && d.photo_url.size() <= 2048
          && d.photo_url.matches('https://[^/]+.*')));
    }
    function validDonorSubmission(s) {
      return s.keys().hasAll(['donor_payload','committee_assignment_id','submitted_by','submitted_at','status',
          'approved_by','approved_at','rejected_by','rejected_at','rejection_reason','donor_id'])
        && s.keys().hasOnly(['donor_payload','committee_assignment_id','submitted_by','submitted_at','status',
          'approved_by','approved_at','rejected_by','rejected_at','rejection_reason','donor_id'])
        && validDonorPayload(s.donor_payload) && nullableString(s.committee_assignment_id)
        && s.submitted_by is string && s.submitted_at is timestamp && s.status in ['pending','approved','rejected']
        && nullableString(s.approved_by) && (s.approved_at == null || s.approved_at is timestamp)
        && nullableString(s.rejected_by) && (s.rejected_at == null || s.rejected_at is timestamp)
        && nullableString(s.rejection_reason) && nullableString(s.donor_id);
    }
    function activeCommitteeParticipant(s) {
      return validId(s.committee_assignment_id)
        && get(/databases/$(database)/documents/committee_assignments/$(s.committee_assignment_id)).data.active == true
        && get(/databases/$(database)/documents/committee_assignments/$(s.committee_assignment_id)).data.user_id == ownId()
        && validId(get(/databases/$(database)/documents/committee_assignments/$(s.committee_assignment_id)).data.term_id)
        && get(/databases/$(database)/documents/committee_terms/$(
          get(/databases/$(database)/documents/committee_assignments/$(s.committee_assignment_id)).data.term_id)).data.active == true;
    }
    // Registry stays false/missing until owner-reviewed historical backfill.
    function donorPhoneKeyPath(phone) {
      return /databases/$(database)/documents/donor_phone_keys/$(phone);
    }
    function donorRegistryReady() {
      return exists(/databases/$(database)/documents/system_config/donor_phone_registry)
        && get(/databases/$(database)/documents/system_config/donor_phone_registry).data.ready == true
        && get(/databases/$(database)/documents/system_config/donor_phone_registry).data.schema_version == 1;
    }
    function validPhoneKey(k, phone) {
      return phone.matches('01[3-9][0-9]{8}')
        && k.keys().hasAll(['phone','donor_id','reserved_at','reserved_by'])
        && k.keys().hasOnly(['phone','donor_id','reserved_at','reserved_by'])
        && k.phone == phone && validId(k.donor_id)
        && k.reserved_at == request.time && k.reserved_by == ownId();
    }
    match /system_config/{id} {
      allow get: if id == 'donor_phone_registry' && admitted() && editorial();
    }
    match /donor_phone_keys/{phone} {
      // Individual checks support transactional uniqueness; enumeration
      // and client-side changes/deletions remain forbidden.
      allow get: if admitted() && editorial() && phone.matches('01[3-9][0-9]{8}');
      allow create: if admitted() && editorial() && donorRegistryReady()
        && validPhoneKey(request.resource.data, phone)
        && !exists(/databases/$(database)/documents/donors/$(request.resource.data.donor_id))
        && getAfter(/databases/$(database)/documents/donor_submissions/$(request.resource.data.donor_id)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/donor_submissions/$(request.resource.data.donor_id)).data.approved_by == ownId();
    }
    function donorMatchesSubmission(d, s, id) {
      return d.name == s.donor_payload.name && d.phone == s.donor_payload.phone
        && d.blood_group == s.donor_payload.blood_group && d.gender == s.donor_payload.gender
        && d.photo_url == s.donor_payload.photo_url && d.village == s.donor_payload.village
        && d.union == s.donor_payload.union
        && d.upazila == s.donor_payload.upazila
        && d.district == s.donor_payload.district && d.profession == s.donor_payload.profession
        && d.linked_user_id == null && d.active == true && d.last_donated_at == null
        && d.total_donations == 0 && d.created_at == request.time && d.updated_at == request.time
        && d.created_by == s.submitted_by && d.updated_by == ownId()
        && s.status == 'approved' && s.approved_by == ownId() && s.approved_at == request.time
        && s.donor_id == id && s.rejected_by == null && s.rejected_at == null && s.rejection_reason == null
        && d.phone.matches('01[3-9][0-9]{8}')
        && getAfter(donorPhoneKeyPath(d.phone)).data.donor_id == id;
    }
    match /committee_terms/{id} {
      allow read: if admitted();
    }
    match /committee_assignments/{id} {
      allow read: if admitted();
    }
    match /committee_media/{id} {
      allow read: if admitted() && validId(resource.data.term_id)
        && exists(/databases/$(database)/documents/committee_terms/$(resource.data.term_id))
        && (resource.data.active == true || (resource.data.active == false && editorial()));
    }
    match /events/{id} {
      allow read: if admitted() && eventReadable(resource.data);
    }
    match /event_media/{id} {
      allow read: if admitted() && validId(resource.data.event_id)
        && exists(/databases/$(database)/documents/events/$(resource.data.event_id))
        && eventReadable(get(/databases/$(database)/documents/events/$(resource.data.event_id)).data)
        && (resource.data.active == true || (resource.data.active == false && editorial()));
    }
    match /donors/{id} {
      // Ordinary members can view active donors only. Approval transactions
      // must check that a proposed donor document does NOT already exist.
      // Permit that negative get only to a verified editorial account.
      // A missing document returns exists=false, never any private data.
      allow get: if admitted() && (
        (resource != null && resource.data.active == true)
        || (resource == null && editorial()));
      allow list: if admitted() && resource.data.active == true;
      allow create: if admitted() && editorial() && validDonor(request.resource.data)
        && donorMatchesSubmission(request.resource.data,
          getAfter(/databases/$(database)/documents/donor_submissions/$(id)).data, id);
      allow update: if admitted() && history() && resource.data.active == true
        && validDonor(resource.data) && validDonor(request.resource.data)
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','blood_group',
          'gender','photo_url','village','union','upazila','district','profession','updated_at','updated_by'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['name','blood_group',
          'gender','photo_url','village','union','upazila','district','profession'])
        && request.resource.data.updated_at == request.time && request.resource.data.updated_by == ownId();
    }
    match /donor_submissions/{id} {
      allow read: if admitted() && (resource.data.submitted_by == ownId() || editorial());
      allow create: if admitted() && validDonorSubmission(request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.submitted_by == ownId()
        && request.resource.data.donor_payload.phone.matches('01[3-9][0-9]{8}')
        && request.resource.data.submitted_at == request.time
        && request.resource.data.approved_by == null && request.resource.data.approved_at == null
        && request.resource.data.rejected_by == null && request.resource.data.rejected_at == null
        && request.resource.data.rejection_reason == null && request.resource.data.donor_id == null
        && ((roleIn(['leader','executive','committee']) && activeCommitteeParticipant(request.resource.data))
          || (roleIn(['developer_admin']) && request.resource.data.committee_assignment_id == null));
      allow update: if admitted() && editorial() && validDonorSubmission(resource.data)
        && validDonorSubmission(request.resource.data) && resource.data.status == 'pending'
        && request.resource.data.submitted_by == resource.data.submitted_by
        && request.resource.data.submitted_at == resource.data.submitted_at
        && request.resource.data.donor_payload == resource.data.donor_payload
        && request.resource.data.committee_assignment_id == resource.data.committee_assignment_id
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approved_by','approved_at','donor_id'])
            && request.resource.data.status == 'approved' && request.resource.data.approved_by == ownId()
            && resource.data.donor_payload.phone.matches('01[3-9][0-9]{8}')
            && request.resource.data.approved_at == request.time && request.resource.data.donor_id == id
            && request.resource.data.rejected_by == null && request.resource.data.rejected_at == null
            && request.resource.data.rejection_reason == null
            && getAfter(/databases/$(database)/documents/donors/$(id)).data.active == true
            && getAfter(/databases/$(database)/documents/donors/$(id)).data.created_at == request.time
            && getAfter(/databases/$(database)/documents/donors/$(id)).data.created_by == resource.data.submitted_by)
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rejected_by','rejected_at','rejection_reason'])
            && request.resource.data.status == 'rejected' && request.resource.data.rejected_by == ownId()
            && request.resource.data.rejected_at == request.time && request.resource.data.rejection_reason is string
            && request.resource.data.rejection_reason.size() > 0 && request.resource.data.approved_by == null
            && request.resource.data.approved_at == null && request.resource.data.donor_id == null
            && !existsAfter(/databases/$(database)/documents/donors/$(id)))
        );
    }
    match /donations/{id} {
      allow read: if admitted() && history();
    }
    match /notices/{id} {
      allow read: if admitted() && (resource.data.status == 'published'
        || (resource.data.status in ['draft','archived'] && editorial()));
    }
    match /blood_requests/{id} {
      allow read: if admitted() && (resource.data.status == 'active'
        || (resource.data.status in ['fulfilled','cancelled'] && history()));
      allow create: if admitted()
        && request.resource.data.keys().hasAll(['blood_group','patient_name','hospital','location',
          'contact_name','contact_phone','required_at','status','created_by','created_at','fulfilled_by','fulfilled_at'])
        && request.resource.data.keys().hasOnly(['blood_group','patient_name','hospital','location',
          'contact_name','contact_phone','required_at','status','created_by','created_at','fulfilled_by','fulfilled_at'])
        && request.resource.data.blood_group is string && nullableString(request.resource.data.patient_name)
        && request.resource.data.hospital is string && request.resource.data.location is string
        && request.resource.data.contact_name is string && request.resource.data.contact_phone is string
        && (request.resource.data.required_at == null || request.resource.data.required_at is timestamp)
        && request.resource.data.status == 'active' && request.resource.data.created_by == ownId()
        && request.resource.data.created_at == request.time
        && request.resource.data.fulfilled_by == null && request.resource.data.fulfilled_at == null;
    }
    match /audit_logs/{id} {
      allow read: if admitted() && roleIn(['developer_admin']);
    }
    // The developer_admin role is an application authority, NOT a privileged
    // Firebase Admin SDK credential. Firestore ORs overlapping match grants,
    // so do not add a broad allow to known collections here.
    // Account creation/linking/role changes, committee mutation, audit writes,
    // and editorial lifecycle actions require independently authorized trusted
    // execution. Ordinary member-facing operations remain allowed above.
    // Includes legacy requests and every unlisted collection/subcollection.
    // No role (including developer_admin) bypasses these client denials.
    match /{document=**} { allow read, write: if false; }
  }
}
